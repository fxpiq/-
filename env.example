# LiveClip runtime configuration. Run deploy/install.sh to generate a random password.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Public live streams often work without cookies. Mount an authorized Netscape
# cookie file here only when the stream requires a logged-in account.
COOKIE_FILE=/app/secrets/cookies.txt

# Storage and recorder limits.
LIVECLIP_DATA_DIR=/app/data
SEGMENT_SECONDS=300
MAX_RECORD_SECONDS=14400
MIN_FREE_GB=20
MERGE_RESERVE_GB=8
KEEP_SEGMENTS=false

# CPU defaults. Use medium for better Mandarin accuracy if RAM allows.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CHUNK_SECONDS=600
WHISPER_BEAM_SIZE=3

# Optional OpenAI-compatible model for a second-pass highlight ranking.
# Leaving these blank keeps the fully local ranking path enabled.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Set to 127.0.0.1 when Nginx provides the public entry point.
BIND_ADDRESS=0.0.0.0

